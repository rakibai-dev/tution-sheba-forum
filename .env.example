# Server-side Environment Variables (Set these in Netlify Dashboard & local .env)
# DO NOT prefix these with VITE_ to prevent them from being bundled into client JavaScript.

# Admin password for unlocking the application
ADMIN_PASSWORD=change-me-to-your-secure-password

# Secret key used to cryptographically sign session JWT tokens (generate a long random string)
JWT_SECRET=tuition-sheba-secret-key-32-chars-long-min-auth-session

# Upstream API base URL (kept strictly server-side)
UPSTREAM_API_BASE=https://api.tuitionsebaforum.com
